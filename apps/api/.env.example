# CollabBoard API — environment variables
#
# Copy to `.env` for local overrides (`.env` is gitignored). Every variable below
# has a default baked into internal/config that matches the root
# docker-compose.yml, so an unmodified checkout runs with none of these set.
#
# The values here are local development values only. Real credentials come from
# the environment in deployed environments and must never be committed.

# --- Application -------------------------------------------------------------
# "development" keeps Gin in debug mode; anything else switches to release mode.
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=info

# --- HTTP server -------------------------------------------------------------
# Blank binds all interfaces.
HTTP_HOST=
HTTP_PORT=8080
# Go duration strings, e.g. 10s, 1m.
HTTP_READ_HEADER_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=15s

# --- Postgres ----------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=collabboard
# disable for local docker; require/verify-full against RDS.
POSTGRES_SSLMODE=disable
# Upper bound on pooled connections held by one API instance.
POSTGRES_MAX_CONNS=10

# The serving identity. collabboard_app is not a superuser, has no BYPASSRLS,
# and owns no tables, so row-level security actually applies to it — see
# docs/adr/0001-tenant-isolation.md. Do not point this at the owner role.
#
# Migration 00001 creates the role without a password; locally, set one with
# apps/api/scripts/dev/set-app-role-password.sql after the first `migrate up`.
POSTGRES_USER=collabboard_app
POSTGRES_PASSWORD=dev

# The migrating identity, used only by `api migrate`. This role owns the schema
# and can run DDL, which is exactly why the API must not connect as it.
POSTGRES_MIGRATION_USER=collabboard
POSTGRES_MIGRATION_PASSWORD=dev

# --- Redis -------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Empty for the local compose stack, which runs without auth.
REDIS_PASSWORD=
REDIS_DB=0

# --- Auth --------------------------------------------------------------------
# Signs and verifies access tokens. HMAC-SHA256, so the signature is only as
# strong as this value: minimum 32 bytes, and it must come from the secret store
# in any deployed environment.
#
# Deliberately left blank here. Outside APP_ENV=development the service refuses
# to start without it; in development it generates a random one per process, so
# a local restart invalidates local tokens and nothing in this repository is
# ever a working key. Generate one with:
#
#   openssl rand -hex 32
AUTH_JWT_SECRET=

# Stamped on issue and asserted on verification, so a token minted by another
# service sharing the secret does not verify here.
AUTH_TOKEN_ISSUER=collabboard
AUTH_TOKEN_AUDIENCE=collabboard-api

# Short, because nothing consults a datastore to validate an access token: this
# is the window in which a revoked session or a removed membership still works.
AUTH_ACCESS_TOKEN_TTL=15m
# How long a session can be kept alive by refreshing. Revocable at any point.
AUTH_REFRESH_TOKEN_TTL=336h
# Leeway on exp/nbf. Extends the life of every expired token by exactly this
# much, so keep it small.
AUTH_CLOCK_SKEW=30s

# argon2id cost for NEW credentials: RFC 9106's second recommended parameter set
# (19 MiB / 2 passes / 1 lane), which is the memory-constrained one. Existing
# credentials store their own parameters, so raising these re-derives an account
# on its next login rather than locking anyone out. They cannot be lowered below
# these values -- internal/auth and the CHECK constraints in migration 00005
# both refuse.
AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_ITERATIONS=2
AUTH_ARGON2_PARALLELISM=1
AUTH_ARGON2_KEY_LENGTH=32
AUTH_ARGON2_SALT_LENGTH=16
# Login performs a derivation whether or not the account exists, so ~19 MiB per
# in-flight login is an availability surface. This bounds it: excess logins
# queue and then fail, rather than the process being OOM-killed.
AUTH_ARGON2_MAX_CONCURRENT=4

# Login rate limits. Two budgets sharing one fixed window: the per-account one
# is tight, because credential stuffing shows up as attempts against a single
# address; the per-address one is loose, because a NAT puts many real users
# behind one IP.
AUTH_LOGIN_RATE_PER_ACCOUNT=5
AUTH_LOGIN_RATE_PER_ADDRESS=30
AUTH_LOGIN_RATE_WINDOW=15m
