# CollabBoard API — environment variables
#
# Copy to `.env` for local overrides (`.env` is gitignored). Every variable below
# has a default baked into internal/config that matches the root
# docker-compose.yml, so an unmodified checkout runs with none of these set.
#
# The values here are local development values only. Real credentials come from
# the environment in deployed environments and must never be committed.

# --- Application -------------------------------------------------------------
# "development" keeps Gin in debug mode; anything else switches to release mode.
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=info

# --- HTTP server -------------------------------------------------------------
# Blank binds all interfaces.
HTTP_HOST=
HTTP_PORT=8080
# Go duration strings, e.g. 10s, 1m.
HTTP_READ_HEADER_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=15s

# Caps a request body, in bytes. net/http bounds headers and nothing else, so
# without this a single POST allocates whatever the caller cares to send — and
# the endpoint an anonymous caller can reach, /auth/login, would be the cheapest
# way to exhaust the process. Over the limit is 413.
#
# 256 KiB is not a round guess: the largest body the API's own field limits allow
# is a card with a 200 rune title and a 10 000 rune description, and one rune
# costs at most twelve bytes of JSON (an astral character written as an escaped
# surrogate pair), so ~120 KiB is the legitimate worst case and this is twice it.
# Revisit when attachments arrive — those will not go through a JSON body.
HTTP_MAX_REQUEST_BYTES=262144

# The same cap for the four routes that answer before anyone has authenticated:
# /auth/register, /auth/login, /auth/refresh, /auth/logout. Tighter because none
# of them carries anything large — an email is at most 254 bytes, a password 128,
# a display name 128 runes — and because they are the ones an anonymous caller
# can reach. Must not exceed HTTP_MAX_REQUEST_BYTES; the service refuses to start
# if it does, since the looser limit is applied first and the tighter one would
# never take effect.
HTTP_MAX_UNAUTHENTICATED_REQUEST_BYTES=16384

# --- Postgres ----------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=collabboard
# disable for local docker; require/verify-full against RDS.
POSTGRES_SSLMODE=disable
# Upper bound on pooled connections held by one API instance.
POSTGRES_MAX_CONNS=10

# The serving identity. collabboard_app is not a superuser, has no BYPASSRLS,
# and owns no tables, so row-level security actually applies to it — see
# docs/adr/0001-tenant-isolation.md. Do not point this at the owner role.
#
# POSTGRES_PASSWORD is used twice and deliberately: the API authenticates with
# it, and `api provision` writes it into the database. Migration 00001 creates
# the role without a password, because a credential in a versioned migration can
# never be rotated — this variable is where it comes from instead. In a deployed
# environment it is injected from the secret store (an ECS `secrets:` entry
# resolving a Secrets Manager ARN), and rotating it means: change the secret, run
# `api provision`, roll the tasks, in that order.
POSTGRES_USER=collabboard_app
POSTGRES_PASSWORD=dev

# The migrating identity, used by `api migrate` and `api provision`. This role
# owns the schema and can run DDL, which is exactly why the API must not connect
# as it. It is also NOT the cluster's superuser or the RDS master: it is a
# dedicated non-superuser created by
# apps/api/scripts/provision/bootstrap-owner.sql, so that FORCE ROW LEVEL
# SECURITY is exercised by the role that owns the tables rather than skipped.
# See docs/adr/0006-database-role-provisioning.md. `api migrate` refuses to run
# as anything row-level security is not enforced against.
POSTGRES_MIGRATION_USER=collabboard_owner
POSTGRES_MIGRATION_PASSWORD=dev

# --- Redis -------------------------------------------------------------------
# With REDIS_TLS_ENABLED=true this is also the name the server's certificate is
# checked against, so it must be the ElastiCache primary endpoint's DNS name.
# An IP address here fails verification: Go sends no SNI for an IP literal and
# requires a matching IP SAN, which the ElastiCache certificate does not carry.
REDIS_HOST=localhost
REDIS_PORT=6379
# Empty for the local compose stack, which runs without auth.
REDIS_PASSWORD=
REDIS_DB=0
# false for local docker; true against ElastiCache, which is created with
# transit_encryption_enabled = true and refuses a plaintext client outright
# rather than downgrading. The certificate is verified against the system trust
# store, with the server name taken from REDIS_HOST — there is no
# skip-verification setting and adding one would defeat the point.
#
# A boolean rather than POSTGRES_SSLMODE's vocabulary on purpose: libpq's
# "require" means encrypt without verifying, which this service does not offer,
# so there is no third state to name. See internal/redisclient.
REDIS_TLS_ENABLED=false

# --- Auth --------------------------------------------------------------------
# Signs and verifies access tokens. HMAC-SHA256, so the signature is only as
# strong as this value: minimum 32 bytes, and it must come from the secret store
# in any deployed environment.
#
# Deliberately left blank here. Outside APP_ENV=development the service refuses
# to start without it; in development it generates a random one per process, so
# a local restart invalidates local tokens and nothing in this repository is
# ever a working key. Generate one with:
#
#   openssl rand -hex 32
AUTH_JWT_SECRET=

# Stamped on issue and asserted on verification, so a token minted by another
# service sharing the secret does not verify here.
AUTH_TOKEN_ISSUER=collabboard
AUTH_TOKEN_AUDIENCE=collabboard-api

# Short, because nothing consults a datastore to validate an access token: this
# is the window in which a revoked session or a removed membership still works.
AUTH_ACCESS_TOKEN_TTL=15m
# How long a session can be kept alive by refreshing. Revocable at any point.
AUTH_REFRESH_TOKEN_TTL=336h
# Leeway on exp/nbf. Extends the life of every expired token by exactly this
# much, so keep it small.
AUTH_CLOCK_SKEW=30s

# argon2id cost for NEW credentials: RFC 9106's second recommended parameter set
# (19 MiB / 2 passes / 1 lane), which is the memory-constrained one. Existing
# credentials store their own parameters, so raising these re-derives an account
# on its next login rather than locking anyone out. They cannot be lowered below
# these values -- internal/auth and the CHECK constraints in migration 00005
# both refuse.
AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_ITERATIONS=2
AUTH_ARGON2_PARALLELISM=1
AUTH_ARGON2_KEY_LENGTH=32
AUTH_ARGON2_SALT_LENGTH=16
# Login performs a derivation whether or not the account exists, so ~19 MiB per
# in-flight login is an availability surface. This bounds it: excess logins
# queue and then fail, rather than the process being OOM-killed.
AUTH_ARGON2_MAX_CONCURRENT=4

# Login rate limits. Two budgets sharing one fixed window: the per-account one
# is tight, because credential stuffing shows up as attempts against a single
# address; the per-address one is loose, because a NAT puts many real users
# behind one IP.
AUTH_LOGIN_RATE_PER_ACCOUNT=5
AUTH_LOGIN_RATE_PER_ADDRESS=30
AUTH_LOGIN_RATE_WINDOW=15m

# --- Realtime (WebSocket hub) ------------------------------------------------
# See apps/api/internal/realtime/README.md.

# Comma-separated Origin patterns accepted on a WebSocket handshake. Blank means
# same-origin only, which is the strict answer and the wrong one for this
# product: the SPA is served from another host, so a deployed environment has to
# name it. Deliberately NOT defaulted to "*" — an origin allow-list that defaults
# to open is an allow-list nobody ever configures.
#
# Blank here, because in development the service fills in the local Next.js
# origins on its own and a value that only applies when APP_ENV=development
# cannot reach production by being forgotten.
REALTIME_ALLOWED_ORIGINS=

# Frames that may queue for one connection before the hub gives up on it. A
# client that fills this is closed with code 4002 rather than blocking the
# board's other clients or silently missing events — see the README.
REALTIME_SEND_BUFFER=64

# Keepalive and dead-connection reaping. The ping interval stays comfortably
# under the 60s idle timeout an AWS ALB applies by default, so a quiet board does
# not get its connections reaped by the load balancer. A peer that fails to pong
# within the timeout is dropped: that is the only way to notice a client that
# vanished without closing its TCP connection.
REALTIME_PING_INTERVAL=25s
REALTIME_PONG_TIMEOUT=10s

# Bounds a single frame write to one client.
REALTIME_WRITE_TIMEOUT=5s

# Caps an inbound frame. Client frames are a type and a uuid.
REALTIME_READ_LIMIT_BYTES=32768

# How often a live connection re-checks its membership and its subscriptions
# against the database. This is the bound on how long a revoked membership keeps
# receiving events; the other bound is AUTH_ACCESS_TOKEN_TTL, because a
# connection is closed when the token that authorized it expires.
REALTIME_REAUTHORIZE_INTERVAL=30s

# How many boards one socket may watch.
REALTIME_MAX_BOARDS_PER_CONNECTION=16

# Inbound pub/sub messages that may queue before the broker's reader blocks.
REALTIME_BROKER_BUFFER=256

# Base delay a draining instance asks clients to wait before reconnecting,
# jittered per connection so a rolling deploy does not produce a synchronised
# reconnect storm.
REALTIME_SHUTDOWN_RECONNECT_HINT=1s
