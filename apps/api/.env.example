# CollabBoard API — environment variables
#
# Copy to `.env` for local overrides (`.env` is gitignored). Every variable below
# has a default baked into internal/config that matches the root
# docker-compose.yml, so an unmodified checkout runs with none of these set.
#
# The values here are local development values only. Real credentials come from
# the environment in deployed environments and must never be committed.

# --- Application -------------------------------------------------------------
# "development" keeps Gin in debug mode; anything else switches to release mode.
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=info

# --- HTTP server -------------------------------------------------------------
# Blank binds all interfaces.
HTTP_HOST=
HTTP_PORT=8080
# Go duration strings, e.g. 10s, 1m.
HTTP_READ_HEADER_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=15s

# --- Postgres ----------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=collabboard
# disable for local docker; require/verify-full against RDS.
POSTGRES_SSLMODE=disable
# Upper bound on pooled connections held by one API instance.
POSTGRES_MAX_CONNS=10

# The serving identity. collabboard_app is not a superuser, has no BYPASSRLS,
# and owns no tables, so row-level security actually applies to it — see
# docs/adr/0001-tenant-isolation.md. Do not point this at the owner role.
#
# Migration 00001 creates the role without a password; locally, set one with
# apps/api/scripts/dev/set-app-role-password.sql after the first `migrate up`.
POSTGRES_USER=collabboard_app
POSTGRES_PASSWORD=dev

# The migrating identity, used only by `api migrate`. This role owns the schema
# and can run DDL, which is exactly why the API must not connect as it.
POSTGRES_MIGRATION_USER=collabboard
POSTGRES_MIGRATION_PASSWORD=dev

# --- Redis -------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Empty for the local compose stack, which runs without auth.
REDIS_PASSWORD=
REDIS_DB=0
