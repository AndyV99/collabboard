# Copy to .env.local for local development. .env* is gitignored except this file.

# Base URL of the Go API (apps/api). Server-only: it is read from the process
# environment on every request, never inlined into the build, so one built image
# runs against a different API per environment with no rebuild.
#
# No trailing slash needed — one is stripped. A path prefix is allowed
# (https://example.com/api); a query string or fragment is not.
#
# Unset falls back to http://localhost:8080, which matches docker-compose.yml
# plus `go run ./cmd/api` from apps/api — so local dev needs no .env.local.
# Set-but-malformed (empty, no scheme, an unsubstituted ${...} placeholder) is
# a deployment mistake and stops the server at startup rather than silently
# falling back to localhost.
API_URL=http://localhost:8080
