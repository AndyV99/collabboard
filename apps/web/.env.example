# Copy to .env.local for local development. .env* is gitignored except this file.

# Base URL of the Go API (apps/api). Server-only: it is read from the process
# environment on every request, never inlined into the build, so one built image
# runs against a different API per environment with no rebuild.
#
# No trailing slash needed — one is stripped. A path prefix is allowed
# (https://example.com/api); a query string or fragment is not.
#
# Unset falls back to http://localhost:8080, which matches docker-compose.yml
# plus `go run ./cmd/api` from apps/api — so local dev needs no .env.local.
# Set-but-malformed (empty, no scheme, an unsubstituted ${...} placeholder) is
# a deployment mistake and stops the server at startup rather than silently
# falling back to localhost.
API_URL=http://localhost:8080

# How many bytes may sit unread in one browser's event stream before this server
# gives up on that viewer, closes its stream with 4002 and releases the upstream
# WebSocket.
#
# This is the web tier's half of a bound the API already has. apps/api caps a
# WebSocket connection at REALTIME_SEND_BUFFER frames and closes an overrunning
# one; that protects the API and does nothing for this process, because the
# relay reads the socket as fast as the API produces regardless of whether the
# browser is reading. Without a bound here, a backgrounded tab or a suspended
# laptop makes this server hold every frame for it, without limit.
#
# Bytes rather than frames — unlike REALTIME_SEND_BUFFER — because what runs out
# here is memory, and an event payload is anywhere up to the API's 64 KiB cap.
#
# Unset uses 1 MiB, which a reading browser never approaches: the runtime pulls
# from the stream as it writes to the socket, so only a consumer that has
# genuinely stopped accumulates. A dropped viewer reconnects and re-fetches
# through its normal recovery path, so this is a degradation and not an outage.
#
# Unlike API_URL, a malformed value here does NOT stop the server: it logs and
# uses the default. This is a tuning knob on a request path, not a security
# boundary, and refusing to serve realtime because somebody typed "1MB" would be
# the worse failure.
REALTIME_RELAY_BUFFER_BYTES=1048576
