# Copy to .env.local for local development. .env* is gitignored except this file.

# Base URL of the Go API (apps/api). No trailing slash needed — one is stripped.
# Defaults to http://localhost:8080 when unset, which matches docker-compose.yml
# plus `go run ./cmd/api` from apps/api.
#
# NOTE: NEXT_PUBLIC_* values are inlined at build time, so changing this after
# `npm run build` has no effect until the app is rebuilt.
NEXT_PUBLIC_API_URL=http://localhost:8080
